# 复制为 .env 后填写。.env 已被 .gitignore 忽略，不会进仓库。

# ---------- 数据库 ----------
# 博客与 twikoo 共用同一个库（collection 里有 Posts/FLinks/Users 以及 comment/counter/config）
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/?retryWrites=true&w=majority
# 可选，默认 AriaBlogNext
DB_NAME=AriaBlogNext

# ---------- 鉴权 ----------
# 后台 JWT 签名密钥；同时用于 twikoo 延迟上报接口的 secret
SECRET=

# ---------- 其它 ----------
QBU_TOKEN=

# ---------- 友链申请邮件通知 ----------
# 取值可从 twikoo 的 config 集合里照抄（SMTP_HOST/PORT/SECURE 常为空，由 SMTP_SERVICE 推导）：
#   SMTP_SERVICE=qiye.aliyun -> smtp.qiye.aliyun.com:465 (SSL)
# 全部留空时邮件功能自动跳过，接口仍正常工作。
SMTP_HOST=smtp.qiye.aliyun.com
SMTP_PORT=465
# true/ssl -> SSL(465)；starttls -> STARTTLS(587)；false -> 明文（仅本地调试）
SMTP_SECURE=true
SMTP_USER=
SMTP_PASS=
# 发件邮箱，默认取 SMTP_USER
SMTP_FROM=
SMTP_FROM_NAME=友链
# 可选：博主邮箱，收到申请时抄送一份提醒
FLINK_ADMIN_EMAIL=

# ---------- 邮件里的站点信息 ----------
SITE_NAME=Ariasakaの小窝
SITE_URL=https://blog.yaria.top
# 邮件头部的站点图标
SITE_LOGO=https://img.0v0.my/2025/10/12/6dd5eec4823f8.webp
# 可选：后台地址（博主通知邮件里的「去后台处理」按钮）
FLINK_ADMIN_PANEL_URL=
